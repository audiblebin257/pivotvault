# PivotVault Backend Environment Variables

# Server
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"

# JWT
JWT_SECRET=your-jwt-secret-here

# AI / Search
TAVILY_API_KEY=your-tavily-key
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key

# SEC EDGAR Integration
# Required by SEC Fair Access policy: a descriptive User-Agent with contact info
SEC_USER_AGENT="PivotVault/1.0 (research; contact: admin@pivotvault.app)"
# Set to 'false' to disable the daily incremental sync cron
SEC_SYNC_ENABLED=true
# Cron expression for the incremental sync (default: daily at 02:30 UTC)
SEC_SYNC_CRON="30 2 * * *"

# On-demand company import (V2)
# Set to 'false' to disable weekly refresh of cached company profiles
COMPANY_REFRESH_ENABLED=true
# Weekly refresh cron (default: Sundays 04:00 UTC)
COMPANY_REFRESH_CRON="0 4 * * 0"

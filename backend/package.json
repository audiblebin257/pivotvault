{
  "name": "pivotvault-backend",
  "version": "1.0.0",
  "description": "PivotVault API - Startup Failure Intelligence Platform",
  "main": "src/index.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "npx prisma migrate deploy && npx prisma db seed && node src/index.js",
    "pipeline:start": "node src/pipeline/index.js",
    "pipeline:dev": "nodemon src/pipeline/index.js",
    "pregenerate": "node scripts/pregenerate-analyses.js",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset --force"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/client": "^5.22.0",
    "@tavily/core": "^0.7.6",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.28.1",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^1.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "node-cron": "^4.5.0",
    "pgvector": "^0.3.0",
    "striptags": "^3.2.0",
    "tiktoken": "^1.0.22",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}

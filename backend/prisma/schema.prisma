// ==============================================
// ANALYTICS & MONITORING
// ==============================================
enum AnalyticsEventType {
  page_view
  api_request
  search_query
  bookmark_add
  bookmark_remove
  ai_chat
  ai_analysis_run
  document_chunked
  graph_generated
  company_imported
  notification_sent
  report_downloaded
}

model AnalyticsEvent {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @db.Uuid
  eventType   AnalyticsEventType
  eventName   String              @db.VarChar(255)
  properties  Json                @default("{}")
  ipAddress   String?             @db.VarChar(50)
  userAgent   String?             @db.VarChar(1000)
  createdAt   DateTime            @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_events")
  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
}

model ApiRequest {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  method      String   @db.VarChar(10)
  path        String   @db.VarChar(500)
  statusCode  Int
  responseTimeMs Int
  userAgent   String?  @db.VarChar(1000)
  ipAddress   String?  @db.VarChar(50)
  requestBody Json?    @default("{}")
  errorMessage String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_requests")
  @@index([method, path])
  @@index([createdAt])
  @@index([userId])
  @@index([statusCode])
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("bookmarks")
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String   @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_history")
}

model Confession {
  id         String   @id @default(uuid()) @db.Uuid
  text       String   @db.VarChar(280)
  upvotes    Int      @default(0)
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@map("confessions")
}

// ==============================================
// KNOWLEDGE GRAPH - UNIFIED EDGE TABLE
// ==============================================
model GraphEdge {
  id              String          @id @default(uuid()) @db.Uuid
  edgeType        GraphEdgeType
  // Source & Target (polymorphic, but we'll use company as primary for now)
  sourceType      String          @db.VarChar(50)
  sourceId        String          @db.Uuid
  targetType      String          @db.VarChar(50)
  targetId        String          @db.Uuid
  // Metadata
  edgeWeight      Decimal         @db.Decimal(5,2) @default(1.0)
  description     String?         @db.Text
  // Timestamps
  createdAt       DateTime        @default(now()) @db.Timestamptz

  @@map("graph_edges")
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([edgeType])
}

// ==============================================
// SEC EDGAR INTEGRATION
// ==============================================
enum SecFilingType {
  TEN_K
  TEN_Q
  EIGHT_K
  S_1
  DEF_14A
  TWENTY_F
}

model SecCompany {
  id          String   @id @default(uuid()) @db.Uuid
  cik         String   @unique @db.VarChar(20) // Central Index Key (10-digit with leading zeros)
  tickers     String[] @default([])
  name        String   @db.VarChar(255)
  businessAddress String? @db.VarChar(500)
  phone       String? @db.VarChar(50)
  lastSynced  DateTime? @db.Timestamptz
  lastModifiedDate DateTime? @db.Timestamptz
  etag        String? @db.VarChar(200) // For incremental sync
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  companyId String? @db.Uuid // Link to existing Company model
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  filings   SecFiling[]
  metadata  SecMetadata[]
  financials SecFinancial[]
  riskFactors SecRiskFactor[]
  extracts    SecFilingExtract[]
  intelligence SecFilingIntelligence[]
  filingChunks SecFilingChunk[]
  importJobs   CompanyImportJob[]

  @@map("sec_companies")
  @@index([cik])
  @@index([tickers])
  @@index([companyId])
}

model SecFiling {
  id               String            @id @default(uuid()) @db.Uuid
  secCompanyId     String            @db.Uuid
  accessionNumber  String            @unique @db.VarChar(50)
  filingType       SecFilingType
  filingDate       DateTime?         @db.Date
  reportDate       DateTime?         @db.Date
  fiscalYear       Int?
  fiscalPeriod     String? @db.VarChar(20)
  url              String            @db.VarChar(500)
  primaryDocument  String? @db.VarChar(255)
  primaryDocumentType String? @db.VarChar(50)
  sizeBytes        BigInt?
  status           String @default("pending") @db.VarChar(50) // pending, processing, complete, failed
  etag             String? @db.VarChar(200)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)
  documents  SecDocument[]
  financials SecFinancial[]
  riskFactors SecRiskFactor[]
  extracts    SecFilingExtract[]
  intelligence SecFilingIntelligence[]
  citations   SecFilingCitation[]
  chunks      SecFilingChunk[]

  @@map("sec_filings")
  @@index([secCompanyId])
  @@index([accessionNumber])
  @@index([filingType])
  @@index([filingDate])
}

model SecDocument {
  id             String   @id @default(uuid()) @db.Uuid
  secFilingId    String   @db.Uuid
  sequence       Int?
  fileName       String? @db.VarChar(255)
  description    String? @db.VarChar(255)
  type           String? @db.VarChar(100)
  url            String   @db.VarChar(500)
  sizeBytes      BigInt?
  content        String? @db.Text // Stored as fallback
  contentType    String? @db.VarChar(100)
  etag           String? @db.VarChar(200)
  lastFetchedAt  DateTime? @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  secFiling SecFiling @relation(fields: [secFilingId], references: [id], onDelete: Cascade)

  @@map("sec_documents")
  @@index([secFilingId])
}

model SecFinancial {
  id             String   @id @default(uuid()) @db.Uuid
  secCompanyId   String   @db.Uuid
  secFilingId    String   @db.Uuid
  metricKey      String   @db.VarChar(255)
  metricValue    Decimal? @db.Decimal(30,10)
  unit           String? @db.VarChar(100)
  periodStart    DateTime? @db.Date
  periodEnd      DateTime? @db.Date
  fiscalYear     Int?
  fiscalPeriod   String? @db.VarChar(50)
  source         String? @db.VarChar(100)
  sourceConcept  String? @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)
  secFiling  SecFiling @relation(fields: [secFilingId], references: [id], onDelete: Cascade)

  @@map("sec_financials")
  @@index([secCompanyId])
  @@index([secFilingId])
  @@index([metricKey])
  @@index([fiscalYear])
}

model SecRiskFactor {
  id              String   @id @default(uuid()) @db.Uuid
  secCompanyId    String   @db.Uuid
  secFilingId     String   @db.Uuid
  title           String? @db.VarChar(500)
  content         String   @db.Text
  riskCategory    String? @db.VarChar(100)
  confidence      Decimal? @db.Decimal(3,2)
  orderIndex      Int
  createdAt       DateTime @default(now()) @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)
  secFiling  SecFiling @relation(fields: [secFilingId], references: [id], onDelete: Cascade)

  @@map("sec_risk_factors")
  @@index([secCompanyId])
  @@index([secFilingId])
  @@index([riskCategory])
}

model SecMetadata {
  id          String        @id @default(uuid()) @db.Uuid
  secCompanyId String       @db.Uuid
  key         String        @db.VarChar(100)
  value       Json
  createdAt   DateTime      @default(now()) @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)

  @@map("sec_metadata")
  @@unique([secCompanyId, key])
  @@index([key])
}

// ==============================================
// SEC FILING INTELLIGENCE (Phase 2)
// ==============================================
model SecFilingExtract {
  id              String   @id @default(uuid()) @db.Uuid
  secCompanyId    String   @db.Uuid
  secFilingId     String   @db.Uuid
  fieldType       String   @db.VarChar(100)
  fieldKey        String   @default("default") @db.VarChar(100)
  value           String   @db.Text
  valueNumeric    Decimal? @db.Decimal(30,10)
  unit            String?  @db.VarChar(50)
  confidence      Decimal  @db.Decimal(3,2)
  source          String   @db.VarChar(100)
  citationText    String?  @db.Text
  pageNumber      String?  @db.VarChar(20)
  sectionKey      String?  @db.VarChar(100)
  extractedAt     DateTime @default(now()) @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)
  secFiling  SecFiling  @relation(fields: [secFilingId], references: [id], onDelete: Cascade)
  citations  SecFilingCitation[]

  @@map("sec_filing_extracts")
  @@unique([secFilingId, fieldType, fieldKey])
  @@index([secCompanyId])
  @@index([secFilingId])
  @@index([fieldType])
}

model SecFilingIntelligence {
  id                  String   @id @default(uuid()) @db.Uuid
  secCompanyId        String   @db.Uuid
  secFilingId         String?  @db.Uuid
  executiveSummary    String   @db.Text
  financialHealthScore   Int?
  businessHealthScore    Int?
  operationalRiskScore   Int?
  marketRiskScore       Int?
  leadershipRiskScore   Int?
  fundingRiskScore      Int?
  overallHealthScore    Int?
  scoreReasoning        Json?
  generatedAt           DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)
  secFiling  SecFiling? @relation(fields: [secFilingId], references: [id], onDelete: SetNull)

  @@map("sec_filing_intelligence")
  @@index([secCompanyId])
  @@index([secFilingId])
}

model SecFilingCitation {
  id              String   @id @default(uuid()) @db.Uuid
  secFilingExtractId String? @db.Uuid
  secFilingId     String   @db.Uuid
  text            String   @db.Text
  pageNumber      String?  @db.VarChar(20)
  sectionKey      String?  @db.VarChar(100)
  confidence      Decimal? @db.Decimal(3,2)
  createdAt       DateTime @default(now()) @db.Timestamptz

  secFilingExtract SecFilingExtract? @relation(fields: [secFilingExtractId], references: [id], onDelete: SetNull)
  secFiling        SecFiling        @relation(fields: [secFilingId], references: [id], onDelete: Cascade)

  @@map("sec_filing_citations")
  @@index([secFilingId])
  @@index([secFilingExtractId])
}

// ==============================================
// SEC RAG SEARCH (Phase 3)
// ==============================================
model SecFilingChunk {
  id              String   @id @default(uuid()) @db.Uuid
  secCompanyId    String   @db.Uuid
  secFilingId     String   @db.Uuid
  chunkIndex      Int
  content         String   @db.Text
  sectionKey      String?  @db.VarChar(100)
  sectionTitle    String?  @db.VarChar(255)
  citationText    String   @db.Text
  pageNumber      String?  @db.VarChar(20)
  confidence      Decimal  @default(0.80) @db.Decimal(3,2)
  metadata        Json     @default("{}")
  embedding       Unsupported("vector")?
  embeddingModel  String?  @db.VarChar(100)
  tokenCount      Int?
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  secCompany SecCompany @relation(fields: [secCompanyId], references: [id], onDelete: Cascade)
  secFiling  SecFiling  @relation(fields: [secFilingId], references: [id], onDelete: Cascade)

  @@map("sec_filing_chunks")
  @@unique([secFilingId, chunkIndex])
  @@index([secCompanyId])
  @@index([secFilingId])
  @@index([sectionKey])
}

// ==============================================
// ON-DEMAND COMPANY IMPORT (V2)
// ==============================================
model CompanyImportJob {
  id              String             @id @default(uuid()) @db.Uuid
  query           String             @db.VarChar(500)
  dedupeKey       String             @unique @db.VarChar(120)
  identifier      String?            @db.VarChar(255)
  cik             String?            @db.VarChar(20)
  ticker          String?            @db.VarChar(20)
  companyId       String?            @unique @db.Uuid
  secCompanyId    String?            @db.Uuid
  status          CompanyCacheStatus @default(NEW)
  progress        Json               @default("[]")
  currentStep     String?            @db.VarChar(100)
  errorMessage    String?            @db.Text
  profileSnapshot Json?
  sourcesUsed     Json               @default("[]")
  retryCount      Int                @default(0)
  maxRetries      Int                @default(3)
  startedAt       DateTime?          @db.Timestamptz
  finishedAt      DateTime?          @db.Timestamptz
  lastRefreshedAt DateTime?          @db.Timestamptz
  createdAt       DateTime           @default(now()) @db.Timestamptz
  updatedAt       DateTime           @updatedAt @db.Timestamptz

  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  secCompany SecCompany? @relation(fields: [secCompanyId], references: [id], onDelete: SetNull)

  @@map("company_import_jobs")
  @@index([status])
  @@index([cik])
  @@index([query])
}

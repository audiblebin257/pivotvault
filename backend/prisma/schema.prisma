generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ==============================================
// ENUMERATIONS
// ==============================================
enum CompanyStatus {
  failed
  acquired
  pivoted
  zombie
  operating
  public
}

enum FailureCategory {
  retention
  monetization
  pmf
  cac
  competition
  team
  timing
  regulation
  other
  product
  legal
  unit_economics
  operations
  leadership
  community
  strategy
  cashflow
  platform_risk
  execution
  pricing
  fraud
  ethics
}

enum TimelineStage {
  idea
  prototype
  launch
  growth
  decline
  shutdown
  acquisition
  pivot
}

enum GraphOutcome {
  shutdown
  acquired
  pivoted
}

enum ImportStatus {
  pending
  processing
  success
  failed
  validated
  duplicate
}

enum CompanyCacheStatus {
  NEW
  PROCESSING
  READY
  FAILED
  UPDATING
}

enum SourceType {
  manual
  website
  api
  rss
  pdf
  article
}

enum GraphEdgeType {
  FOUNDER_COMPANY
  INVESTOR_COMPANY
  COMPETITOR_COMPANY
  COMPANY_FAILURE_PATTERN
  COMPANY_INDUSTRY
  COMPANY_TECHNOLOGY
  COMPANY_MARKET
  COMPANY_PRODUCT
  COMPANY_ACQUISITION
  COMPANY_ACCELERATOR
  COMPANY_FUNDING_ROUND
  COMPANY_FOUNDER
  FOUNDER_FOUNDER
  INVESTOR_INVESTOR
  INDUSTRY_INDUSTRY
}

// ==============================================
// CORE TABLES
// ==============================================

// Company = Startup
model Company {
  id             String            @id @default(uuid()) @db.Uuid
  // Core Identity
  name           String            @db.VarChar(255)
  slug           String            @unique @db.VarChar(255)
  alternativeNames Json            @default("[]")
  status         CompanyStatus     @default(failed)
  // Industry & Geography
  industry       String            @db.VarChar(100)
  industryId     String?           @db.Uuid
  country        String            @db.VarChar(100)
  state          String?           @db.VarChar(100)
  city           String?           @db.VarChar(100)
  // Timeline
  foundingYear   Int?
  shutdownYear   Int?
  lifetimeMonths Int?
  // Size & Metrics
  fundingInr     BigInt?
  fundingUsd     BigInt?
  peakUsers      Int?
  teamSize       Int?
  // Branding
  logoUrl        String?           @db.Text
  websiteUrl     String?           @db.VarChar(255)
  // Text Content
  summary        String            @db.Text
  description    String?           @db.Text
  founderStory   String?           @db.Text
  // Timestamps
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  // ==============================================
  // RELATIONS
  // ==============================================
  // Identity & Geography
  industryRecord Industry?         @relation("CompanyIndustry", fields: [industryId], references: [id], onDelete: SetNull)
  // People
  founders       Founder[]
  // Funding
  fundingRounds  FundingRound[]
  companyInvestors CompanyInvestor[]
  // Content
  articles       Article[]
  postmortems    Postmortem[]
  failureReasons FailureReason[]
  lessons        Lesson[]
  timelineEvents TimelineEvent[]
  metricsSnapshots MetricsSnapshot[]
  aiAnalyses     AiAnalysis[]
  // Sources & Tags
  tags           CompanyTag[]
  sources        CompanySource[]
  // Duplicate tracking
  duplicates     CompanyDuplicate[] @relation("CompanyDuplicate")
  duplicateOfRecords CompanyDuplicate[] @relation("CompanyDuplicateOf")
  // Import tracking
  importRecords  ImportRecord[]
  // Technologies, Markets, Products, Accelerators
  companyTechnologies CompanyTechnology[]
  companyMarkets CompanyMarket[]
  companyProducts CompanyProduct[]
  companyAccelerators CompanyAccelerator[]
  // Acquisitions
  acquisitions    Acquisition[]  @relation("AcquiringCompany")
  acquiredIn      Acquisition?  @relation("AcquiredCompany")
  // Competitors
  competitorsFrom CompanyCompetitor[] @relation("CompetitorSource")
  competitorsTo   CompanyCompetitor[] @relation("CompetitorTarget")
  // NOTE: GraphEdge is a polymorphic table (sourceId/targetId are plain Uuids,
  // not FKs), so there are no typed relation fields to it here.
  // User
  bookmarks      Bookmark[]
  // Embeddings
  documentChunks DocumentChunk[]
  // Portfolios, benchmarks
  portfolioCompanies PortfolioCompany[]
  startupBenchmarks  StartupBenchmark[]
  // SEC EDGAR
  secCompanies   SecCompany[]
  importJob      CompanyImportJob?

  // ==============================================
  // INDEXES
  // ==============================================
  @@map("companies")
  @@index([status])
  @@index([industry])
  @@index([country])
  @@index([foundingYear])
  @@index([shutdownYear])
}

// ==============================================
// PEOPLE
// ==============================================
model Founder {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  name        String     @db.VarChar(255)
  role        String?    @db.VarChar(255)
  bio         String?    @db.Text
  linkedinUrl String?    @db.VarChar(255)
  twitterUrl  String?    @db.VarChar(255)
  isPrimary   Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("founders")
  @@index([companyId])
}

// ==============================================
// FUNDING & INVESTORS
// ==============================================
model FundingRound {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  roundType    String           @db.VarChar(100)
  amountInr    BigInt?
  amountUsd    BigInt?
  currency     String?          @default("USD") @db.VarChar(10)
  announcementDate DateTime?     @db.Date
  valuation    BigInt?
  leadInvestor String?          @db.VarChar(255)
  description  String?          @db.Text
  isConfirmed  Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investorRounds InvestorRound[]

  @@map("funding_rounds")
  @@index([companyId])
  @@index([roundType])
}

model Investor {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @db.VarChar(255)
  slug         String           @unique @db.VarChar(255)
  type         String?          @db.VarChar(100)
  description  String?          @db.Text
  websiteUrl   String?          @db.VarChar(255)
  logoUrl      String?          @db.Text
  headquarters String?          @db.VarChar(255)
  createdAt    DateTime         @default(now()) @db.Timestamptz

  investorRounds InvestorRound[]
  companyInvestors CompanyInvestor[]

  @@map("investors")
  @@index([type])
}

model InvestorRound {
  id             String     @id @default(uuid()) @db.Uuid
  investorId     String     @db.Uuid
  fundingRoundId String     @db.Uuid
  amountInr      BigInt?
  amountUsd      BigInt?
  isLead         Boolean    @default(false)
  createdAt      DateTime   @default(now()) @db.Timestamptz

  investor     Investor     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  fundingRound FundingRound @relation(fields: [fundingRoundId], references: [id], onDelete: Cascade)

  @@unique([investorId, fundingRoundId])
  @@map("investor_rounds")
}

model CompanyInvestor {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  investorId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([companyId, investorId])
  @@map("company_investors")
}

// ==============================================
// CONTENT & POSTMORTEMS
// ==============================================
model Article {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  title       String     @db.VarChar(500)
  content     String?    @db.Text
  url         String     @unique @db.VarChar(1000)
  publishedAt DateTime   @db.Timestamptz
  source      String?    @db.VarChar(255)
  author      String?    @db.VarChar(255)
  summary     String?    @db.Text
  isPrimary   Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("articles")
  @@index([companyId])
  @@index([source])
}

model Postmortem {
  id                  String     @id @default(uuid()) @db.Uuid
  companyId           String     @db.Uuid
  title               String     @db.VarChar(500)
  content             String     @db.Text
  author              String?    @db.VarChar(255)
  publishedAt         DateTime?  @db.Timestamptz
  isOfficial          Boolean    @default(false)
  isPivotVaultCurated Boolean    @default(false)
  createdAt           DateTime   @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("postmortems")
  @@index([companyId])
}

// ==============================================
// FAILURE ANALYSIS
// ==============================================
model FailureReason {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  category      FailureCategory
  description   String          @db.Text
  severityScore Int             @default(50)
  isPrimary     Boolean         @default(false)
  createdAt     DateTime        @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("failure_reasons")
  @@index([companyId])
  @@index([category])
}

model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  title     String   @db.VarChar(500)
  content   String   @db.Text
  priority  String?  @db.VarChar(50)
  isKey     Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("lessons")
  @@index([companyId])
  @@index([priority])
}

model TimelineEvent {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  stage       TimelineStage
  eventDate   DateTime       @db.Date
  title       String         @db.VarChar(255)
  description String         @db.Text
  metricKey   String?        @db.VarChar(100)
  metricValue Decimal?       @db.Decimal(10,2)
  createdAt   DateTime       @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("timeline_events")
  @@index([companyId])
  @@index([stage])
}

model MetricsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  recordedMonth DateTime @db.Date
  users        Int?
  revenueInr   BigInt?
  revenueUsd   BigInt?
  mrrInr       BigInt?
  mrrUsd       BigInt?
  burnRateInr  BigInt?
  burnRateUsd  BigInt?
  churnRate    Decimal? @db.Decimal(5,2)
  ltv          Decimal? @db.Decimal(10,2)
  cac          Decimal? @db.Decimal(10,2)
  createdAt    DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("metrics_snapshots")
  @@index([companyId])
}

model AiAnalysis {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @unique @db.Uuid
  retentionScore   Int      @default(50)
  monetizationScore Int    @default(50)
  pmfScore         Int      @default(50)
  marketingScore   Int      @default(50)
  primaryCause     String   @db.VarChar(100)
  confidence       Int      @default(80)
  recommendations  Json     @default("[]")
  rawLlmResponse   String?  @db.Text
  generatedAt      DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

// ==============================================
// KNOWLEDGE GRAPH ENTITIES
// ==============================================
model Technology {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @db.Timestamptz

  companyTechnologies CompanyTechnology[]

  @@map("technologies")
  @@index([category])
}

model Market {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @db.Timestamptz

  companyMarkets CompanyMarket[]

  @@map("markets")
  @@index([category])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @db.Timestamptz

  companyProducts CompanyProduct[]

  @@map("products")
  @@index([category])
}

model Accelerator {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  location    String?  @db.VarChar(255)
  websiteUrl  String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz

  companyAccelerators CompanyAccelerator[]

  @@map("accelerators")
}

model Acquisition {
  id                String    @id @default(uuid()) @db.Uuid
  acquiringCompanyId String   @db.Uuid
  acquiredCompanyId String?   @unique @db.Uuid
  acquiredCompanyName String?  @db.VarChar(255)
  amountUsd         BigInt?
  amountInr         BigInt?
  announcementDate  DateTime? @db.Date
  description       String?   @db.Text
  createdAt         DateTime  @default(now()) @db.Timestamptz

  acquiringCompany Company  @relation("AcquiringCompany", fields: [acquiringCompanyId], references: [id], onDelete: Cascade)
  acquiredCompany  Company? @relation("AcquiredCompany", fields: [acquiredCompanyId], references: [id], onDelete: SetNull)

  @@map("acquisitions")
  @@index([acquiringCompanyId])
  @@index([acquiredCompanyId])
}

model CompanyCompetitor {
  id            String   @id @default(uuid()) @db.Uuid
  sourceCompanyId String @db.Uuid
  targetCompanyId String @db.Uuid
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz

  sourceCompany Company @relation("CompetitorSource", fields: [sourceCompanyId], references: [id], onDelete: Cascade)
  targetCompany Company @relation("CompetitorTarget", fields: [targetCompanyId], references: [id], onDelete: Cascade)

  @@unique([sourceCompanyId, targetCompanyId])
  @@map("company_competitors")
}

model CompanyTechnology {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  technologyId  String   @db.Uuid
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([companyId, technologyId])
  @@map("company_technologies")
}

model CompanyMarket {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  marketId      String   @db.Uuid
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([companyId, marketId])
  @@map("company_markets")
}

model CompanyProduct {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  productId     String   @db.Uuid
  isPrimary     Boolean  @default(false)
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
  @@map("company_products")
}

model CompanyAccelerator {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  acceleratorId String   @db.Uuid
  cohort        String?  @db.VarChar(100)
  year          Int?
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)

  @@unique([companyId, acceleratorId, cohort])
  @@map("company_accelerators")
}

// ==============================================
// CLASSIFICATION & METADATA
// ==============================================
model Industry {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  parent   Industry? @relation("IndustryHierarchy", fields: [parentId], references: [id])
  children Industry[] @relation("IndustryHierarchy")
  companies Company[]  @relation("CompanyIndustry")

  @@map("industries")
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  category    String?  @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz

  companyTags CompanyTag[]

  @@map("tags")
  @@index([category])
}

model CompanyTag {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  tagId     String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([companyId, tagId])
  @@map("company_tags")
}

// ==============================================
// SOURCE TRACKING
// ==============================================
model Source {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(255)
  type        SourceType @default(manual)
  url         String?    @db.VarChar(1000)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @db.Timestamptz

  companySources CompanySource[]
  importRecords  ImportRecord[]

  @@map("sources")
}

model CompanySource {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  sourceId      String   @db.Uuid
  url           String?  @db.VarChar(1000)
  confidence    Decimal  @db.Decimal(3,2)
  publishedAt   DateTime? @db.Timestamptz
  lastFetchedAt DateTime? @db.Timestamptz
  createdAt     DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("company_sources")
  @@index([companyId])
}

// ==============================================
// IMPORT & VALIDATION
// ==============================================
model ImportRecord {
  id          String        @id @default(uuid()) @db.Uuid
  sourceId    String?       @db.Uuid
  companyId   String?       @db.Uuid
  status      ImportStatus  @default(pending)
  rawData     Json          @default("{}")
  errors      Json?         @default("[]")
  warnings    Json?         @default("[]")
  confidence  Decimal?      @db.Decimal(3,2)
  startedAt   DateTime?     @db.Timestamptz
  finishedAt  DateTime?     @db.Timestamptz
  retryCount  Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz

  source    Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@map("import_records")
  @@index([status])
}

model CompanyDuplicate {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  duplicateOfId String?  @db.Uuid
  duplicateType String   @db.VarChar(100)
  confidence    Decimal  @db.Decimal(3,2)
  resolution    String?  @db.VarChar(100)
  resolvedAt    DateTime? @db.Timestamptz
  createdAt     DateTime @default(now()) @db.Timestamptz

  company     Company  @relation("CompanyDuplicate", fields: [companyId], references: [id], onDelete: Cascade)
  duplicateOf Company? @relation("CompanyDuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)

  @@map("company_duplicates")
  @@index([companyId])
  @@index([duplicateOfId])
}

// ==============================================
// AI / VECTOR SEARCH READINESS
// ==============================================
model DocumentChunk {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  content         String   @db.Text
  chunkIndex      Int
  chunkType       String?  @db.VarChar(100)
  sourceModel     String?  @db.VarChar(100)
  sourceId        String?  @db.Uuid
  embedding       Unsupported("vector")?
  embeddingModel  String?  @db.VarChar(100)
  tokenCount      Int?
  createdAt       DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
  @@index([companyId])
  @@index([chunkType])
}

// ==============================================
// USER & APP DATA
// ==============================================
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.Text
  avatarUrl    String?  @db.Text
  role         String   @default("founder")
  timezone     String?  @default("UTC")
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  bookmarks          Bookmark[]
  searchHistory      SearchHistory[]
  // New phase 7
  collections        Collection[]
  savedResearch      SavedResearch[]
  aiChatMessages     AiChatMessage[]
  aiMentorSessions   AiMentorSession[]
  weeklyReports      WeeklyReport[]
  learningPathItems  LearningPathItem[]
  notifications      Notification[]
  founderTimeline    FounderTimelineEvent[]
  decisionSimulations DecisionSimulation[]
  whatIfSimulations  WhatIfSimulation[]
  userPortfolios     Portfolio[]
  // Owned startup workspace
  ownedStartups      UserStartup[]
  // Analytics / monitoring
  analyticsEvents    AnalyticsEvent[]
  apiRequests        ApiRequest[]

  @@map("users")
}

// User's portfolio of companies
model Portfolio {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  color       String?  @db.VarChar(20)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies   PortfolioCompany[]

  @@map("portfolios")
}

model PortfolioCompany {
  id         String   @id @default(uuid()) @db.Uuid
  portfolioId String  @db.Uuid
  companyId   String  @db.Uuid
  role        String? @db.VarChar(100) // "owned", "investor", "mentor", "watchlist"
  notes       String? @db.Text
  addedAt     DateTime @default(now()) @db.Timestamptz

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("portfolio_companies")
  @@index([portfolioId])
  @@index([companyId])
}

// User-owned startup
model UserStartup {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
